{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "Represents a software development project.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the project." },
        "title": { "type": "string", "description": "Title of the project." },
        "description": { "type": "string", "description": "Description of the project." },
        "status": { "type": "string", "enum": ["Active", "Processing", "Idle", "Completed"], "description": "Current status of the project." },
        "icon": { "type": "string", "description": "Icon identifier for the project." },
        "technologies": { "type": "array", "items": { "type": "string" }, "description": "List of technologies used." },
        "progress": { "type": "number", "description": "Progress percentage." },
        "health": { "type": "string", "enum": ["Healthy", "Warning", "Critical"], "description": "Health status of the project." },
        "lastUpdated": { "type": "string", "format": "date-time", "description": "Last update timestamp." },
        "activeAgents": { "type": "array", "items": { "type": "string" }, "description": "List of active agents." },
        "ownerId": { "type": "string", "description": "ID of the project owner." },
        "stage": { "type": "string", "description": "Current stage of the project." },
        "brief": { "type": "string", "description": "Discovery brief of the project." }
      },
      "required": ["id", "title", "description", "status", "lastUpdated", "ownerId"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": { "$ref": "Project" },
      "description": "Collection of projects."
    },
    "/projects/{projectId}/chats/{chatId}": {
      "schema": { "$ref": "Chat" },
      "description": "Chat messages for a project."
    },
    "/projects/{projectId}/artifacts/{artifactId}": {
      "schema": { "$ref": "Artifact" },
      "description": "Artifacts generated for a project."
    }
  }
}
