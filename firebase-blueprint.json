{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A software project managed by the agents",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Processing", "Idle", "Completed"] },
        "icon": { "type": "string" },
        "technologies": { "type": "array", "items": { "type": "string" } },
        "progress": { "type": "number" },
        "health": { "type": "string", "enum": ["Healthy", "Warning", "Critical"] },
        "lastUpdated": { "type": "string", "format": "date-time" },
        "activeAgents": { "type": "array", "items": { "type": "string" } },
        "ownerId": { "type": "string" },
        "stage": { "type": "string", "enum": ["discovery", "kickoff", "development"] },
        "brief": { "type": "string" }
      },
      "required": ["id", "title", "ownerId"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A message in a project chat",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "role", "content", "timestamp"]
    },
    "Artifact": {
      "title": "Artifact",
      "description": "A generated file for a project",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "path": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "path", "content", "timestamp"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Main project documents"
    },
    "/projects/{projectId}/chats/{chatId}": {
      "schema": "ChatMessage",
      "description": "Chat history for a project"
    },
    "/projects/{projectId}/artifacts/{artifactId}": {
      "schema": "Artifact",
      "description": "Generated files for a project"
    }
  }
}
